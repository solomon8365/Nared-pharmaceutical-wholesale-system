# =============================================================================
# NARED Pharmacon — environment template
# =============================================================================
# Copy this file to `.env` (same folder) and fill in real values.
#   copy .env.example .env      (Windows)
#   cp   .env.example .env      (macOS/Linux)
#
# `.env` is git-ignored — secrets must never be committed.
# Real process/system environment variables take precedence over this file.
# =============================================================================

# ── MySQL — PRIMARY database ─────────────────────────────────────────────────
# Every piece of business data lives here: products, inventory, batches,
# customers, orders, invoices, payments, delivery, users, permissions, audit.
# Defaults match a stock XAMPP install (root, no password).
DB_HOST=127.0.0.1
DB_NAME=pharma
DB_USER=root
DB_PASS=

# ── Application ──────────────────────────────────────────────────────────────
# true  => hide errors, production error_reporting
# false => show errors (development)
APP_PRODUCTION=false

# ── Supabase — OPTIONAL object storage (files only) ──────────────────────────
# Supabase is used ONLY to store uploaded binary files:
#   • product images
#   • customer/supplier payment screenshots & receipts
#   • delivery proof-of-delivery (POD) photos
#   • expense / refund receipts, CMS images, company logo
#
# It is NEVER used as the business database and NEVER as the login provider:
# MySQL remains the single source of truth for all records, and the existing
# session + role/permission system is unchanged. See docs/SUPABASE.md.
#
# Leave SUPABASE_STORAGE_ENABLED=false (or keys blank) to keep everything on
# the local disk — the application behaves exactly as before.
#
# SUPABASE_URL              : Project URL, e.g. https://abcdefgh.supabase.co
# SUPABASE_SERVICE_ROLE_KEY : service_role secret (server-side ONLY — never in JS)
# SUPABASE_ANON_KEY         : anon/public key (used only if no service key)
# SUPABASE_STORAGE_BUCKET   : bucket name (created by tools/check_services.php)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=nared-uploads
SUPABASE_STORAGE_ENABLED=false
